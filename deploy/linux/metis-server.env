# Environment for the metis-server service, read by
# /usr/lib/systemd/system/metis-server.service (and /etc/init.d/metis-server
# on Alpine).
#
# The package manager keeps your edits to this file across upgrades. It is
# readable by root and the metis-server group only, because it holds secrets.
#
# Every setting is in the README (metis-server's and the engine's); only the
# ones a first start needs are here.

# The PostgreSQL the engine keeps its state in, and metis-server its sign-in
# records. Leave it unset to choose the database in the browser instead: with
# no database configured the server serves only the setup wizard, at
# http://<this server>:8080/setup, which writes the database, the keys and the
# server's address to /var/lib/metis-server/config.yaml and then starts on
# them. The token the wizard asks for is in the log:
#   journalctl -u metis-server | grep "setup token"
#DATABASE_URL=postgres://metis:CHANGE_ME@localhost:5432/metis?sslmode=disable

# Secrets, at least 32 characters each; the server refuses weak ones. When the
# setup wizard writes config.yaml, the values there win.
# Generate with: openssl rand -base64 48
#JWT_SECRET=
# Generate with: openssl rand -hex 24
#ENCRYPTION_KEY=

# Where the web app and the API listen. The default, :8080, is every network
# interface; 127.0.0.1:8080 would limit it to this machine.
#METIS_SERVER_ADDRESS=:8080

# The address people reach this server at, for links in e-mails and redirects.
#METIS_PUBLIC_URL=https://metis.example.com

# What this machine does: all (the default) serves people and runs the
# engine's jobs, timers and deliveries; web serves people only; worker runs
# the work only. Every machine points at the same database.
#METIS_ROLE=all

# Where the engine inside this process serves its API. Loopback, so it is
# reached through metis-server alone; leave it unless the port is taken.
#METIS_HTTP_ADDRESS=127.0.0.1:8273

# Prometheus metrics. Loopback by default.
#METIS_METRICS_ADDRESS=127.0.0.1:9464

# Large variable payloads and the finished-instance archive, if you use the
# directory stores. Keep them under /var/lib/metis-server: the unit makes the
# rest of the filesystem read-only.
#METIS_PAYLOAD_DIR=/var/lib/metis-server/payloads
#METIS_ARCHIVE_DIR=/var/lib/metis-server/archive

# Only to put this server in front of an engine running elsewhere instead of
# the one in its process: that engine's base address. The machine is then a
# web machine that signs nobody in itself.
#METIS_ENGINE_URL=http://engine.internal:8080
