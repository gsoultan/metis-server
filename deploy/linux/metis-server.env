# Environment for the metis-server service, read by
# /usr/lib/systemd/system/metis-server.service (and /etc/init.d/metis-server
# on Alpine).
#
# The package manager keeps your edits to this file across upgrades.

# The metis engine the web app's API calls are forwarded to: http or https,
# no path. Required; the service does not start without it.
#
# The engine's own package listens on :8080 by default, which is also where
# this server listens. On a host that runs both, move the engine to loopback
# by setting this in /etc/metis/metis.env:
#
#   METIS_HTTP_ADDRESS=127.0.0.1:8273
#   METIS_TRUSTED_PROXIES=127.0.0.1/32
#
# which keeps the engine off the network and leaves :8080 to the web app. The
# second line lets the engine believe the browser address this server sends,
# so its rate limiter and audit log see people rather than one proxy.
# On another host, use its address instead, such as http://engine.internal:8080.
METIS_ENGINE_URL=http://127.0.0.1:8273

# Where the web app listens. The default, :8080, is every network interface.
#METIS_SERVER_ADDRESS=:8080
