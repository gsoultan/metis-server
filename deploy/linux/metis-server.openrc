#!/sbin/openrc-run
# OpenRC service for the metis-server apk package (Alpine has no systemd).
#
# Like the systemd unit, a fresh install adds this to the default runlevel and
# starts it; an upgrade leaves it as it was. With DATABASE_URL unset in
# /etc/metis-server/metis-server.env it serves the setup wizard. To keep it
# from starting at boot:
#
#   rc-update del metis-server default

name="metis-server"
description="Metis BPM (web app and BPMN/DMN engine)"
command="/usr/bin/metis-server"
command_user="metis-server:metis-server"
directory="/var/lib/metis-server"
supervisor="supervise-daemon"
respawn_delay=5
output_log="/var/log/metis-server/metis-server.log"
error_log="/var/log/metis-server/metis-server.log"
umask=027

depend() {
	need net
	after postgresql
}

start_pre() {
	checkpath -d -m 0750 -o metis-server:metis-server /var/lib/metis-server /var/log/metis-server
	if [ -f /etc/metis-server/metis-server.env ]; then
		set -a
		. /etc/metis-server/metis-server.env
		set +a
	fi
}
