# systemd unit for the metis-server Linux packages (deb, rpm, Arch).
#
# metis-server is the whole of Metis on one machine: the web app, sign-in, and
# the engine in its own process. A fresh install of the package enables and
# starts this; an upgrade leaves it as it was (see scripts/postinstall.sh).
# To keep it from starting at boot:
#
#   systemctl disable --now metis-server
#
# With no DATABASE_URL in /etc/metis-server/metis-server.env it serves only the
# setup wizard, at http://<this server>:8080/setup, which chooses the database.
#
# State lives in /var/lib/metis-server, which is also the working directory, so
# the setup wizard's config.yaml lands there and nowhere else. Everything else
# on the filesystem is read-only to the process.
[Unit]
Description=Metis BPM (web app and BPMN/DMN engine)
Documentation=https://github.com/gsoultan/metis-server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=metis-server
Group=metis-server
EnvironmentFile=-/etc/metis-server/metis-server.env
WorkingDirectory=/var/lib/metis-server
ExecStart=/usr/bin/metis-server
Restart=on-failure
RestartSec=5s
# Long enough for the engine in the process to drain in-flight work
# (METIS_SHUTDOWN_DRAIN) before systemd escalates to SIGKILL.
TimeoutStopSec=90s
LimitNOFILE=65536

StateDirectory=metis-server
StateDirectoryMode=0750

# Hardening. The binary is static and needs no privileges: it listens on an
# unprivileged port and writes only to its state directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Refused calls fail with EPERM rather than killing the process, so a library
# probing for an optional call degrades instead of taking the server down.
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
